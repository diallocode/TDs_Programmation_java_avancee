	@Override
    public Resultat call() throws Exception {
        try {
            // Gestion des opérations (exemple : SQUARE)
            if ("SQUARE".equalsIgnoreCase(r.getOperation())) {
                double res = r.getValue() * r.getValue();
                return new Resultat(r.getId(), res);
            } else {
                return new Resultat(r.getId(), "Opération inconnue");
            }
        } catch (Exception e) {
            // Gestion des erreurs demandée par l'exercice[cite: 2]
            return new Resultat(r.getId(), e.getMessage());
        }
    }

}
