package exercice_4;

public class Compte {
	private int id;
	private double solde;
	
	public Compte(int id, double s) {
		this.id = id;
		this.solde = s;
	}
	
	public synchronized void retirer(double m) throws InterruptedException {
		if(solde <= 0 || solde < m) {
			wait();
		}
		this.solde -= m;
		notify();
	}
	
	public synchronized void ajouter(double m) {
		this.solde += m;
	}
	
	public double getSolde() {
		return this.solde;
	}
}
