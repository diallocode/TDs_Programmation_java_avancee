package exercice_6;

import java.util.concurrent.locks.Condition;
import java.util.concurrent.locks.ReadWriteLock;
import java.util.concurrent.locks.ReentrantReadWriteLock;

public class SystemReservation {
	private int MAX_PLACES = 100;
	private int[] places;
	private final ReadWriteLock lock = new ReentrantReadWriteLock();
	private final Condition placeLibre = lock.writeLock().newCondition(); // Verrou d'attente pour l'ecriture
	
	public SystemReservation(int[] p, int nb) {
		this.places = p;
		this.MAX_PLACES = nb;
	}
	
	// places[i] : 1--> occupe, 0-->libre
	public  boolean isAvailable(int place) {
		lock.readLock().lock();
		try {
            return places[place] == -1;
        } finally {
            lock.readLock().unlock();
        }
	}
	
	public boolean reserver(int place, int userId)  {
		lock.writeLock().lock();
		try {
			while(places[place] != -1) {
				// pas de wait et notify avec les locks
				
				return false;
			}
			this.places[place] = userId;
			return true;
		
		} finally{
			lock.writeLock().unlock();
		}
	}
	
	public boolean cancel(int place, int userId) {
		lock.writeLock().lock();
		try {
			this.places[place] = -1;
			return true;
		} finally {
			lock.writeLock().unlock();
		}
		
	}
}
