package exercice_8;

import java.util.concurrent.ExecutionException;
import java.util.concurrent.Future;

public class Client implements Runnable {
    private Serveur serveur;
    private int clientId;

    public Client(Serveur serveur, int clientId) {
        this.serveur = serveur;
        this.clientId = clientId;
    }

    @Override
    public void run() {
        // Création d'une requête (Exemple : id=15, operation="SQUARE", value=25)[cite: 2]
        Requete requete = new Requete(clientId, "SQUARE", 25.0);
        
        // Envoi de la requête au serveur, qui la transmet au pool de threads[cite: 3]
        Future<Resultat> futureResultat = serveur.recevoirRequete(requete);
        
        try {
            // Récupération bloquante du résultat asynchrone[cite: 3, 4]
            Resultat resultat = futureResultat.get();
            System.out.println("Client " + clientId + " -> " + resultat);
        } catch (InterruptedException | ExecutionException e) {
            e.printStackTrace();
        }
    }
}