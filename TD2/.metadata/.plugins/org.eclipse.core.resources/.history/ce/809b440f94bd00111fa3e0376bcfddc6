package exercice_4;

public class Main {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		Compte[] compte = new Compte[100];
		
		for(int i = 0; i<100; i++) {
			compte[i] = new Compte(i,1000);
		}
		
		
		Operations o = new Operations(compte);
		
		// Threads.
		Thread[] t = new Thread[20];
		for(int i = 0; i<20; i++) {
			t[i] = new Thread(o);
		}
		
		// Start
		for(int i=0; i<20; i++) {
			t[i].start();
		}
		
		//
		for(int i=0; i<20; i++) {
			try {
				t[i].join();
			} catch (InterruptedException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
		
		double solde_f = 0;
		for(int i=0; i<100; i++) {
			double solde = compte[i].getSolde();
			solde_f += solde;
		}
		
		System.out.println("Solde apres operations : " + solde_f);
	}

}
