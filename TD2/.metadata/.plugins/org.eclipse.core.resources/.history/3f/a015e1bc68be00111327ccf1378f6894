package exercice_5;
import java.util.LinkedList;
import java.util.Queue;

public class FileAttente {
	private static int nbCommande = 20;
	private LinkedList<Commande> file; 
	
	public FileAttente() {
		this.file = new LinkedList<>();
	}
	
	public synchronized void retCommande() {
		if(file.size() <= 0) {
			try {
				wait();
			} catch (InterruptedException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
		file.remove();
		notify();
	}
	
	public synchronized void addCommande(Commande c) throws InterruptedException {
			if(file.size() > 20) {
				wait();
			}
			file.add(c);
			notify();
	}

}
