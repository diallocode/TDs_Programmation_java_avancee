package exercice_6;

import java.util.concurrent.locks.ReadWriteLock;
import java.util.concurrent.locks.ReentrantReadWriteLock;

public class SystemReservation {
	private int MAX_PLACES = 100;
	private int[] places;
	private final ReadWriteLock lock = new ReentrantReadWriteLock();
	
	public SystemReservation(int[] p, int nb) {
		this.places = p;
		this.MAX_PLACES = nb;
	}
	
	// places[i] : 1--> occupe, 0-->libre
	public  boolean isAvailable(int place) {
		lock.readLock().lock();
		if(this.places[place] == 0) {
			return true;
		}
		return false;
	}
	
	public synchronized void reserver(int place) {
		while(!isAvailable(place)) {
			try {
				wait();
			} catch (InterruptedException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
		this.places[place] = 1;
		notifyAll();
	}
	
	public synchronized void cancel(int place) {
		this.places[place] = 0;
	}
}
