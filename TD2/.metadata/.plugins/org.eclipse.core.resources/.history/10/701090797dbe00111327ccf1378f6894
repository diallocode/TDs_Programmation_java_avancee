package exercice_6;
import java.util.Random;

public class Utilisateur implements Runnable{
	private SystemReservation s;
	private int nbPlaces;
	
	public Utilisateur(SystemReservation s, int nbP) {
		this.s = s;
		this.nbPlaces = nbP;
	}
	
	@Override
	public void run() {
	    int i = 0;
	    Random r = new Random();
	    while(i < nbPlaces) {
	        int res = r.nextInt(100);
	        try {
	            // Une chance sur deux de réserver ou d'annuler (pour l'exemple)
	            if (r.nextBoolean()) {
	                s.reserver(res);
	            } else {
	                s.cancel(res);
	            }
	        } catch (InterruptedException e) {
	            e.printStackTrace();
	        }
	        i++;
	    }
	}
}
