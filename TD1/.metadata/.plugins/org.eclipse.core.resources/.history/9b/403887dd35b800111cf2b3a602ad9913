package Exercice3;

public class Personne implements Homme{

	private String nom;
	private String prenom;
	
	public Personne(String name, String prenom) {
		this.nom = name;
		this.prenom = prenom;
	}

	@Override
	public void identite() {
		System.out.println("nom : " + this.nom + " , " + " prenom : " + this.prenom);
	}
	
}
